PORT=8080
NODE_ENV=development
DEFAULT_JURISDICTION=GLOBAL
ARCHIVE_LEDGER_MODE=mock

# ── Local open-weight backend (Phase 0 / FREE-BRAIN.md) ──
# When LOCAL_MODEL_URL is set, BRO runs entirely offline — zero cloud API calls.
# Any OpenAI-compatible server works: Ollama (http://127.0.0.1:11434/v1),
# vLLM (http://127.0.0.1:8000/v1), llama.cpp (http://127.0.0.1:8080/v1).
# An OPENAI_BASE_URL pointing at localhost is also honored as the URL.
LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5-coder:7b
# LOCAL_API_KEY=local        # most local servers accept any bearer token
# BRO_LOCAL_FALLBACK=1       # set to fall back to cloud providers if the local server fails

# ── Brain cascade: free hosted providers (brain_cascade.py / FREE-BRAIN.md §5) ──
# The local server is always tried first. Each provider below is added to the
# cascade only when its key is present, so an offline user still gets [local].
# Free tiers are hard rate caps: a failed provider is benched (cooldown) and the
# next one takes the call. `python3 agent_runtime.py --providers` shows the chain.
# BRAIN_CASCADE=0            # local only — the mode FREE-BRAIN.md's offline test needs
# BRAIN_PROVIDERS=groq,gemini  # override the order / keep just these
# BRAIN_CLOUD_TIMEOUT_MS=60000 # per-hop timeout for hosted providers
# BRAIN_BLOCKED_COOLDOWN_S=300 # cooldown after an edge/WAF block (see below)
# BRAIN_PAYMENT_COOLDOWN_S=3600 # cooldown after a 402 paid wall (see CEREBRAS below)
# BRAIN_PROBE_TIMEOUT_MS=15000   # per-hop cap for `--ping-chat` (1-token probe)
#
# Free tiers cap per KEY, so extra keys of one provider are extra cascade hops
# (`groq`, `groq#2`, ...) and a rate-limited key benches only itself:
#   GROQ_API_KEY=k1
#   GROQ_API_KEY_2=k2          # numbered siblings: _2 .. _9
#   GROQ_API_KEYS=k1,k2,k3     # or a csv list (registry var + S)
#
# Note: providers behind Cloudflare (Groq) answer `403 error code: 1010` to the
# default Python-urllib User-Agent. agent_runtime.py always sends its own UA for
# this reason — a bare urllib/curl probe with the default UA will look rejected
# even though the key is fine.
# GROQ_API_KEY=              # https://console.groq.com/keys  (fastest free tier)
# CEREBRAS_API_KEY=          # https://cloud.cerebras.ai
#   Observed live 2026-09-13: a key can authenticate (/v1/models -> 200) while
#   every /chat/completions answers `402 payment_required` (Cerebras stops API
#   access on the Free Trial tier until credits are purchased). That classifies
#   as `payment` and benches the hop for an hour, so it costs one failed attempt
#   and never blocks the chain — the key starts serving the moment you add
#   credits, no config change.
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey (AI Studio free tier)
# OPENROUTER_API_KEY=        # https://openrouter.ai/keys  (use ":free" model slugs)
# MISTRAL_API_KEY=           # https://console.mistral.ai
# GITHUB_TOKEN=              # https://models.github.ai  (free with a GitHub account)
# GROQ_MODEL=gpt-oss-120b    # per-provider model override (also CEREBRAS_MODEL, GEMINI_MODEL, ...)

# ── Q1 evidence log (agent_runtime.py / FREE-BRAIN.md §1) ──
# Every model step appends one JSONL record of measured tokens/s to this file
# (default <residence>/evidence/q1-evidence.jsonl). "" disables the write.
# EVIDENCE_FILE=q1-evidence.jsonl

# ── Drive residence & connector (agent_runtime.py / FREE-BRAIN.md) ──
# The residence is the agent's persistent home: state, instructions, ledger,
# evidence and generated code live in a folder that mirrors to Google Drive
# (or any rclone remote). The model reaches it only via the allowlisted
# drive_sync tool (status|push|pull) — never arbitrary paths.
DRIVE_RESIDENCE=freebrain-residence
# DRIVE_REMOTE=gdrive:freebrain   # rclone remote (run `rclone config` once)

# ── Drift loop (drift_loop.py / FREE-BRAIN.md Q4) ──
# FREE_BRAIN_OBJECTIVE=Maintain a coherent self-rewriting cognitive loop...
#
# Deployment (P6) does not read this file:
#   always-on VM   → /etc/freebrain.env   (deploy/oracle/ORACLE.md)
#   card-free CI   → env comes from .github/workflows/drift-runner.yml
#                    (deploy/actions/GITHUB-ACTIONS.md)
# --max-seconds stops the loop cleanly before an ephemeral host is killed.

# ── QIH instance (QIH.md / agent_runtime.py --activate) ──
# The QIH agent's home is QIH_RESIDENCE (then DRIVE_RESIDENCE, then
# qih-residence/). Keeping the two instances' homes separate matters: when
# DRIVE_RESIDENCE was the only knob, pointing it at QIH silently routed the Free
# Brain's ledger, evidence and provider-health into qih-residence/.
# `python3 agent_runtime.py --activate` gates + records the activation command,
# then runs one Perceive->Plan->Act->Evaluate loop against the QIH objective.
# QIH_RESIDENCE=qih-residence
# QIH_DRIVE_REMOTE=gdrive:qih    # the QIH residence's own rclone remote
# QIH_OBJECTIVE=Maintain a coherent QIH instance that runs the Perceive-Plan-Act-Evaluate loop...