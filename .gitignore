# Secrets must never land here — the workflow reads env from the workflow file.
.env
.env.local
__pycache__/
*.pyc
node_modules/
# Ephemeral runtime junk (the residence's durable state IS committed)
freebrain-residence/rag/*.tmp
# Runtime logs from the phone watchdog (freebrain-residence/ IS committed)
drift-run.log
ollama.log
.drift_exit_code
