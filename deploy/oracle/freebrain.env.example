# /etc/freebrain.env — runtime env for freebrain-loop.service on the VM.
# bootstrap.sh writes this file (it will not overwrite an existing one).
# Copy to /etc/freebrain.env and edit.

# ── the brain: the local open-weight server ────────────────────────────────
LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5-coder:7b

# ── the residence: the agent's memory (files ARE the machine) ──────────────
DRIVE_RESIDENCE=/opt/builderbro/freebrain-residence
# DRIVE_REMOTE=gdrive:freebrain     # after `rclone config`; enables the mirror timer

# ── the immutable objective (drift_loop.py gates rewrites against this) ────
FREE_BRAIN_OBJECTIVE=Maintain a coherent self-rewriting cognitive loop that preserves its stated objective across 1000 continuous cycles without cognitive drift or infinite recursion.

# ── throughput evidence (agent_runtime._emit_step auto-appends here) ───────
# EVIDENCE_FILE=/opt/builderbro/freebrain-residence/evidence/q1-evidence.jsonl

# ── no cloud keys on purpose ───────────────────────────────────────────────
# This box is the zero-API-calls configuration FREE-BRAIN.md's offline test
# wants. Do not add BRAIN_PROVIDERS / *_API_KEY here: with the local server up,
# the cascade never leaves 127.0.0.1 anyway, and an empty file is proof.
